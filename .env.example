# Gemini API key（server 端使用，勿暴露到 client）— https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google Maps JavaScript API key（由 server 於請求時讀取後傳給地圖元件；請在 GCP Console 設定網域限制）
GOOGLE_MAPS_API_KEY=
# （可選）日本 e-Stat 政府統計 API 的免費 appId — https://www.e-stat.go.jp/api/
# 設定後，名古屋情境的 get_official_stats 會查詢 e-Stat；未設定則回傳申請指引。
# 馬來西亞 data.gov.my 免金鑰，不需設定。
ESTAT_APP_ID=
